{
  "name": "jeffreyemanuel-site",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.3",
  "engines": {
    "npm": "DO NOT USE NPM - Use bun instead",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "preinstall": "node -e \"if (process.env.npm_execpath.indexOf('npm') !== -1) { console.error('\\n\\n❌ ERROR: This project uses BUN, not npm!\\n\\nPlease use: bun install\\n\\n'); process.exit(1); }\"",
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "build:with-stats": "bun run update-stats && rm -rf .next && next build",
    "update-stats": "bun run scripts/update-stats.ts",
    "fetch-tldr-stars": "bun run scripts/fetch-tldr-stars.ts",
    "prerender:og": "bun run scripts/prerender-og.ts",
    "start": "next start",
    "check:interactive-article-scopes": "bun run scripts/validate-interactive-article-scopes.ts",
    "check:links": "bun run scripts/check-links.ts",
    "lint": "bun run check:interactive-article-scopes && eslint --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@octokit/rest": "^22.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@types/d3": "^7.4.3",
    "clsx": "^2.1.1",
    "d3": "^7.9.2",
    "feed": "^5.2.1",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/minimatch": "^6.0.0",
    "@types/node": "25.2.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.4.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "^0.19.1"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
